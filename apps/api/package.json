{
  "name": "@sql-lab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --maxWorkers=1 --no-file-parallelism",
    "db:setup": "tsx src/database/setup.ts",
    "db:reset": "tsx src/database/reset.ts"
  },
  "dependencies": {
    "@sql-lab/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pg-cursor": "^2.22.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/pg-cursor": "^2.7.2",
    "tsx": "^4.20.5",
    "vitest": "5.0.2"
  }
}
