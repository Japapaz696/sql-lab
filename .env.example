# Configuração local do SQL Lab.
#
# Este arquivo NUNCA é versionado: o .gitignore cobre ".env" e ".env.*",
# liberando apenas ".env.example".
#
# Para desenvolvimento local, o PostgreSQL pode ser local (veja
# `docs/INSTALACAO.md`) ou o gratuito do Neon.

# Banco usado pela API. Apontar para um banco já preparado (schema + seed).
DATABASE_URL=postgresql://sql_lab:sql_lab@localhost:5432/sql_lab

# Banco separado, usado só pelos testes. Precisa existir e estar vazio:
# a suíte recria o schema a cada execução.
TEST_DATABASE_URL=postgresql://sql_lab:sql_lab@localhost:5432/sql_lab_test

# Porta da API
PORT=3000

# Origem liberada para o front-end em desenvolvimento (CORS).
ALLOWED_ORIGIN=http://localhost:5173

# Número máximo de linhas devolvidas por uma consulta do laboratório.
MAX_RESULT_ROWS=200

# Tempo máximo de uma consulta, em milissegundos.
QUERY_TIMEOUT_MS=5000
