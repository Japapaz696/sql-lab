# Configuração local do SQL Lab.
#
# Este arquivo NUNCA é versionado: o .gitignore cobre ".env" e ".env.*",
# liberando apenas ".env.example".
#
# Para desenvolvimento local, o PostgreSQL pode ser local (veja
# `docs/INSTALACAO.md`) ou o gratuito do Neon.

# Conexão usada para EXECUTAR as consultas do aluno.
#
# Aponte para o usuário sem permissão de escrita (sql_lab_exec). A separação
# de privilégios é a terceira camada de proteção: a transação READ ONLY e o
# protocolo estendido já impedem a escrita, mas o papel garante isso mesmo
# fora de uma transação.
#
# A senha vem de SQL_LAB_EXEC_PASSWORD: o script que cria o papel não tem
# senha nenhuma no repositório.
DATABASE_URL=postgresql://sql_lab_exec:troque-esta-senha@localhost:5432/sql_lab

# Conexão usada pela APLICAÇÃO: para gravar o progresso e preparar o banco.
# Deve ser o usuário dono do schema. O SQL de quem usa o laboratório nunca
# passa por ela.
DATABASE_ADMIN_URL=postgresql://sql_lab:sql_lab@localhost:5432/sql_lab

# Banco separado, usado só pelos testes. Precisa existir e estar vazio:
# a suíte recria o schema a cada execução.
TEST_DATABASE_URL=postgresql://sql_lab_exec:troque-esta-senha@localhost:5432/sql_lab_test

# Banco separado, usado só pelos testes, para preparar o schema.
TEST_DATABASE_ADMIN_URL=postgresql://sql_lab:sql_lab@localhost:5432/sql_lab_test

# Senha do papel de execução (sql_lab_exec).
#
# Não fica no repositório: o script de privilégios lê o valor por parâmetro.
# Em desenvolvimento, este valor tem que ser o mesmo que está em
# DATABASE_URL e em TEST_DATABASE_URL. Use 16 caracteres ou mais.
SQL_LAB_EXEC_PASSWORD=troque-esta-senha

# Confirmação exigida pelo `npm run db:reset`.
#
# A preparação recria o schema inteiro. Num banco com dados de verdade, isso
# apagaria tudo — por isso o comando recusa rodar sem esta confirmação, e
# recusa bancos cujo nome não seja de laboratório (sql_lab, sql_lab_test,
# sql_lab_demo).
SQL_LAB_CONFIRMAR_RESET=sim

# Porta da API
PORT=3000

# Origem liberada para o front-end (CORS).
#
# Aceita uma lista separada por vírgula, para a mesma API servir à interface
# de produção e à de desenvolvimento.
ALLOWED_ORIGIN=http://localhost:5173

# Número máximo de linhas devolvidas por uma consulta do laboratório.
# O cursor para de ler no limite: a consulta não traz o resultado inteiro
# para a memória do processo.
MAX_RESULT_ROWS=200

# Tempo máximo de uma consulta, em milissegundos.
QUERY_TIMEOUT_MS=5000

# Quantas consultas podem rodar ao mesmo tempo neste processo.
#
# O pool de leitura tem cinco conexões; o padrão (4) deixa uma livre para o
# /ready. Cada execução usa duas consultas (a do aluno e a de referência),
# então o mínimo útil é 2. O excedente espera na fila.
MAX_CONCURRENT_QUERIES=4

# Quanto tempo uma consulta espera na fila antes de receber 503 com
# Retry-After, em milissegundos.
QUEUE_WAIT_MS=8000

# Limite de chamadas por IP, por janela. A execução é a rota mais cara; o
# EXPLAIN é mais barato, mas também abre conexão.
RATE_LIMIT_EXECUTE_MAX=20
RATE_LIMIT_EXPLAIN_MAX=15
RATE_LIMIT_WINDOW_MS=60000
