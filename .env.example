# Configuração local do SQL Lab.
#
# Este arquivo NUNCA é versionado: o .gitignore cobre ".env" e ".env.*",
# liberando apenas ".env.example".
#
# Para desenvolvimento local, o PostgreSQL pode ser local (veja
# `docs/INSTALACAO.md`) ou o gratuito do Neon.

# Conexão usada para EXECUTAR as consultas do aluno.
#
# Aponte para o usuário sem permissão de escrita (sql_lab_exec). A separação
# de privilégios é a terceira camada de proteção: a transação READ ONLY e o
# protocolo estendido já impedem a escrita, mas o papel garante isso mesmo
# fora de uma transação.
DATABASE_URL=postgresql://sql_lab_exec:sql_lab_exec@localhost:5432/sql_lab

# Conexão usada SÓ para preparar o banco (criar tabelas, índices e carga).
# Deve ser o usuário dono do schema.
DATABASE_ADMIN_URL=postgresql://sql_lab:sql_lab@localhost:5432/sql_lab

# Banco separado, usado só pelos testes. Precisa existir e estar vazio:
# a suíte recria o schema a cada execução.
TEST_DATABASE_URL=postgresql://sql_lab_exec:sql_lab_exec@localhost:5432/sql_lab_test

# Porta da API
PORT=3000

# Origem liberada para o front-end em desenvolvimento (CORS).
ALLOWED_ORIGIN=http://localhost:5173

# Número máximo de linhas devolvidas por uma consulta do laboratório.
# O cursor para de ler no limite: a consulta não traz o resultado inteiro
# para a memória do processo.
MAX_RESULT_ROWS=200

# Tempo máximo de uma consulta, em milissegundos.
QUERY_TIMEOUT_MS=5000
